PhysicalSetup // all to be specified in SI units!
{
    xSize 0.02; // = 0.01width
    ySize 0.02; // = 0.005depth
    zSize 0.02; // = 0.02height

    periodicInX false;
    periodicInY false;

    runtime 3;

    uInflow 0.01;
    gravitationalAcceleration 9.81;

    kinematicViscosityFluid 1e-5;
    densityFluid 1000.;

    particleDiameter 0.0024; //0.002 RL= 12
    densityParticle 1100.;
    dynamicFrictionCoefficient 0.15;
    coefficientOfRestitution 0.6;

    particleGenerationSpacing_x 0.01;  //0.00401 previous
    particleGenerationSpacing_y 0.01;
    particleGenerationSpacing_z 0.01;
}

NumericalSetup
{
    dx 0.0004; // in m 0.0002
    uInflow 0.01; // in LBM units, should be smaller than 0.1, this then determines dt

    // product of number of blocks should be equal to number of used processes
    numXBlocks 2;
    numYBlocks 2;
    numZBlocks 2;

    useLubricationForces true;
    numberOfParticleSubCycles 10;
}

Output
{
    infoSpacing 0.001; // in s

    vtkSpacingParticles 0.01; // in s
    vtkSpacingFluid 0.01; // in s
    vtkFolder vtk_out;
}

IntegratorSchemes
{
   ON 0;  // 0 means no integrator is used. Any number other than 0, integrator is used by default

}

boundarytypes
{
    North_type Dirichlet;
    South_type Dirichlet;
    West_type Dirichlet;
    East_type Dirichlet;
    Top_type Dirichlet;
    Bottom_type Dirichlet;
}

boundaryvalues
{
    North_value 1.4768867120487655e-05;
    South_value 1.4768867120487655e-05;
    West_value 1.4768867120487655e-05;
    East_value  1.4768867120487655e-05;
    Top_value   1.4768867120487655e-05;
    Bottom_value 1.4768867120487655e-05;
}

ParticleCharges
{
    maxCharge 8000;
    minCharge 20;
}

