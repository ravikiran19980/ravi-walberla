PhysicalSetup // all to be specified in SI units!
{
    xSize 0.02; // = 10dp
    ySize 0.02; // = 10dp
    zSize 0.12; // = 60dp

    periodicInX true;
    periodicInY true;

    runtime 3;

    uInflow 0.035;
    gravitationalAcceleration 9.81;

    kinematicViscosityFluid 1e-6;
    densityFluid  998.21;

    particleDiameter 0.002; // dp = 2mm
    densityParticle 1300;
    dynamicFrictionCoefficient 0.15;
    coefficientOfRestitution 0.6;

    particleGenerationSpacing_x 0.002;  // spacing between particles = dp
    particleGenerationSpacing_y 0.002;
    particleGenerationSpacing_z 0.002;
}

NumericalSetup
{
    dx 0.0001; // in m 0.0002
    uInflow 0.035; // in LBM units, should be smaller than 0.1, this then determines dt

    // product of number of blocks should be equal to number of used processes
    numXBlocks 2;
    numYBlocks 2;
    numZBlocks 2;

    useLubricationForces true;
    numberOfParticleSubCycles 10;
}

Output
{
    infoSpacing 0.001; // in s

    vtkSpacingParticles 0.01; // in s
    vtkSpacingFluid 0.01; // in s
    vtkFolder showcase;
}

IntegratorSchemes
{
   ON 1;  // 0 means no integrator is used. Any number other than 0, integrator is used by default

}

boundarytypes
{
    North_type Dirichlet;
    South_type Dirichlet;
    West_type Dirichlet;
    East_type Dirichlet;
    Top_type Dirichlet;
    Bottom_type Dirichlet;
}

boundaryvalues
{
    North_value 1.4768867120487655e-05;
    South_value 1.4768867120487655e-05;
    West_value 1.4768867120487655e-05;
    East_value  1.4768867120487655e-05;
    Top_value   1.4768867120487655e-05;
    Bottom_value 1.4768867120487655e-05;
}

ParticleCharges
{
    maxCharge 8000;
    minCharge 20;
}

