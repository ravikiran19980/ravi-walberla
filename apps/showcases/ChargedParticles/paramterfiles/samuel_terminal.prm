PhysicalSetup // all to be specified in SI units!
{
    xSize 0.06; // = width
    ySize 0.06; // = depth
    zSize 0.2; // = height

    periodicInX false;
    periodicInY false;

    runtime 10.0;

    uInflow 0.02307746875;
    gravitationalAcceleration 9.81;

    kinematicViscosityFluid 1e-4;
    densityFluid 1000.;

    particleDiameter 0.0032;
    densityParticle 1100.;
    dynamicFrictionCoefficient 0.15;
    coefficientOfRestitution 0.6;

    particleGenerationSpacing_x 0.01;
    particleGenerationSpacing_y 0.01;
    particleGenerationSpacing_z 0.025;
}

NumericalSetup
{
    dx 0.0002; // in m
    uInflow 0.02307746875; // in LBM units, should be smaller than 0.1, this then determines dt

    // product of number of blocks should be equal to number of used processes
    numXBlocks 10;
    numYBlocks 10;
    numZBlocks 10;

    useLubricationForces true;
    numberOfParticleSubCycles 10;
}

Output
{
    infoSpacing 0.01; // in s

    vtkSpacingParticles 0.01; // in s
    vtkSpacingFluid 0.01; // in s
    vtkFolder stokes_d16;
}

IntegratorSchemes
{
   ON 1;  // 0 means no integrator is used. Any number other than 0, integrator is used by default

}

boundarytypes
{
    North_type Neumann;
    South_type Neumann;
    West_type Neumann;
    East_type Neumann;
    Top_type Dirichlet;
    Bottom_type Dirichlet;
}

boundaryvalues
{
    North_value 0;
    South_value 0;
    West_value  0;
    East_value  0;
    Top_value   543011290.8337704;
    Bottom_value -543011290.8337704;
}

ParticleCharges
{
    maxCharge 80000;
    minCharge 20;
}

// This is for the validations of the terminal velocity
// This file has to be run with the file validations_related/stokes_velocity/StokesVelocity.cpp
