PhysicalSetup // all to be specified in SI units!
{
    simulationName pivVelocityValidation;
    xSize 100e-3; // width
    ySize 100e-3; // depth 0.000564
    zSize 160e-3; // height

    periodicInX false;
    periodicInY false;
    runtime 10.0;

    uInflow 0.12224;
    gravitationalAcceleration 9.81;
    kinematicViscosityFluid 6.04e-5;
    densityFluid 960;
    particleDiameter 15e-3;
    densityParticle 1120;
    dynamicFrictionCoefficient 0.15;
    coefficientOfRestitution 0.6;
    particleGenerationSpacing_x 0.0001;
    particleGenerationSpacing_y 0.0001;
    particleGenerationSpacing_z 0.0001;
}

NumericalSetup
{
    dx 0.000704;
    uInflow 0.01; // in LBM units, should be smaller than 0.1, this then determines dt

    // product of number of blocks should be equal to number of used processes
    numXBlocks 2;
    numYBlocks 2;
    numZBlocks 2;

    useLubricationForces true;
    numberOfParticleSubCycles 10;
}

Output
{
    infoSpacing 0.01; // in s

    vtkSpacingParticles 0.01; // in s
    vtkSpacingFluid 0.01; // in s
    vtkFolder stokes_d8;
}


IntegratorSchemes
{
   ON 1;  // 0 means no integrator is used. Any number other than 0, integrator is used by default

}

ParticleGenerationScheme{
    extendSimulationDomain true;  // true if particle generation should happen by extending
}

BoundaryTypes
{
    North_type Neumann;
    South_type Neumann;
    West_type Neumann;
    East_type Neumann;
    Top_type Dirichlet;
    Bottom_type Dirichlet;
}

BoundaryValues
{
    North_value 0;
    South_value 0;
    West_value  0;
    East_value  0;
    Top_value   64000000000.0;
    Bottom_value -64000000000.0;
}

ParticleCharges
{
    maxCharge 21640.187026807627;
    minCharge 20;
}

// This is also for terminal velocity validation
// But this is for moderate reynolds number cases
// These are validated against the experimental piv results
//  should be run with the file validations_related/experimental_terminal_velocity/MigrationVelocity.cpp file