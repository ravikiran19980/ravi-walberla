PhysicalSetup // all to be specified in SI/ref units
{

    xSize 600;
    ySize 260;
    zSize 260;

    periodicInX true;
    periodicInY false;
    periodicInZ true;

    densityFluid 1.;
    simulationTimeFactor 800;   // total timesteps of simulation = simulationTimeFactor * turnOverPeriod

}

NumericalSetup
{

    // product of number of blocks should be equal to number of used processes
    numXBlocks 2;
    numYBlocks 2;
    numZBlocks 2;

    writeSlice false;

}

TurbulenceSetup
{
    target_bulk_Reynolds        5600;
    target_friction_Reynolds    180;
    target_bulk_velocity        0.085;
    center_line_velocity        0.1;
    nTurnovers                  1;
    wallboundaryCondition       NoSlip;
}


Output
{
    infoSpacing 1000; // in s
    vtkSpacingFluid 10000; // ins
    vtkFolder vtk_out_checkpoint;
    performanceLogFrequency 5000000000;
    checkpointing false;                              // set it to false for the timebeing
    checkpointingFileName testCheckpoint;
}
