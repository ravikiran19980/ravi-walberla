PhysicalSetup // all to be specified in SI/ref units
{

    xSize 1080; // = width  // 4dp
    ySize 540; // = depth  // 4dp
    zSize 360; // = height  // 20dp

    periodicInX true;
    periodicInY true;
    periodicInZ false;

    runtime 1000000000;
    densityFluid 1.;
    particleDiameter 24;
    densityParticle 1.;
    dynamicFrictionCoefficient 0.15;
    coefficientOfRestitution 0.97;
    collisionTimeFactor 1.0;

}

NumericalSetup
{

    // product of number of blocks should be equal to number of used processes
    numXBlocks 2;
    numYBlocks 2;
    numZBlocks 1;

    useLubricationForces true;
    numberOfParticleSubCycles 10;
    useIntegrators true;
    particleSubBlockSize <5, 5, 5>;
    linkedCellWidthRation 1.01;
    particleBarriers true;
    generationDomainFraction <0.95,0.95,0.95>;
    volfraction 0.1;                                            // to be modified between 0.1, 0.2, 0.3 ( 3 values)
    writeSlice false;
    sendDirectlyFromGPU true;

}

TurbulenceSetup
{
    target_bulk_Reynolds        4000;
    target_friction_Reynolds    180;
    target_bulk_velocity        0.05;
}

TemperatureSetup
{
    Thot 1;   // ThotSI = ThotLB   (concentration conversion from SI to LB)
    Tcold 0;
    Tref  0;
    Tparticle 0;
    PrandtlNumber 1;
    diffusivityRatio  1;
    Gr 1000;
}

Output
{
    infoSpacing 1000; // in s
    vtkSpacingParticles 0; // in s
    vtkSpacingFluid 0; // ins
    vtkFolder vtk_out;
    performanceLogFrequency 5000000000;

    convergenceTolerance 0.5;
    timeBlock 120000;                //  2400*25 = 120000   (2400 is the ratio of particle diameter and Uc 24/0.01)
    outputFrequency 10000;         // outputfrequency of the meanFlux.txt file
    averagingTimeBlock 2400000;   // typically take it 1000 * 2400 to ensure good amount of averaging
}
