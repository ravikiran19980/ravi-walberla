PhysicalSetup // all to be specified in SI/ref units
{

    xSize 128;
    ySize 40;
    zSize 64;

    periodicInX true;
    periodicInY false;
    periodicInZ true;

    densityFluid 1.;
    particleDiameter 10;
    densityParticle 1.;
    dynamicFrictionCoefficient 0.15;
    coefficientOfRestitution 0.97;
    collisionTimeFactor 1.0;
    simulationTimeFactor 4;   // total timesteps of simulation = simulationTimeFactor * turnOverPeriod

}

NumericalSetup
{

    // product of number of blocks should be equal to number of used processes
    numXBlocks 1;
    numYBlocks 1;
    numZBlocks 1;
    gpuBlockSize   < 800, 1, 1>;

    useLubricationForces true;
    useParticles false;
    numberOfParticleSubCycles 1;
    useIntegrators true;
    particleSubBlockSize <2, 2, 2>;
    linkedCellWidthRation 1.01;
    particleBarriers true;
    generationDomainFraction <0.95,0.95,0.95>;
    volfraction 0.1;                  // this must be 0 if useParticles is false

}

TurbulenceSetup
{
    target_bulk_Reynolds        5600;
    target_friction_Reynolds    180;
    target_bulk_velocity        0.086;
    center_line_velocity        0.1;
    nTurnovers                  1;
}

TemperatureSetup
{
    Thot 1;   // ThotSI = ThotLB   (concentration conversion from SI to LB)
    Tcold 0;
    Tref  0;
    Tparticle 0;
    PrandtlNumber 1;
    diffusivityRatio  1;
    Gr 1000;
}

vtk_params
{
    infoSpacing 1000; // in s
    vtkSpacingParticles 0; // in s
    vtkSpacingFluid 1000; // ins
    vtkFolder vtk_out;
    writeSlice true;



}

checkpoint_params
{
    restart_simulation false;
    startFluidFromCheckPointFile false;
    startTemperatureFromCheckPointFile false;
    startParticlesFromCheckPointFile false;
    checkpointingFileName testCheckpoint_cpu;
    checkPointingFrequency 10000;                   // this is a factor that is multiplied with samplingInterval
    writeContinuousCheckPoints false;
}

statistics_params{
    convergenceTolerance 5;                      // percentage tolerance of wall shear and nusselt numbers
    outputFrequency 10;                        // how often you want to monitor convergence and output the wall statistics
    planeAveragingtimeBlock 10000;               // required only for heat flux budgets
    heatFluxAveragingtimeBlock 600000;           // required only for heat flux budgets

}

performance_params{
    performanceLogFrequency 1000000000;
    sendDirectlyFromGPU false;
    performanceRun false;
}

PIDParameters
{
    targetMeanVelocityMagnitude 0.086;
    proportionalGain            2e-4;
    derivativeGain              1e-6;
    integralGain                2e-4;
    maxRamp                     1e-4;
    minActuatingVariable        0;
    maxActuatingVariable        1e-3;
}

