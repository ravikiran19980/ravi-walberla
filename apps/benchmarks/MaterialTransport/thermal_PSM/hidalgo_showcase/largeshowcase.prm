// Note: Lines specified after "//" are comments and will not be read by the code

PhysicalSetup                         // To be specified in SI units!
{
    showcase true;
    xSize 0.1;                                      // width in SI units
    ySize 0.02;                                     // depth in SI units
    zSize 0.02;                                     // height in SI units
    runtime 5;
    uInflow 0.01;
    kinematicViscosityFluid 1e-5;
    densityFluid 1000.;
    particleDiameter 0.0010;                         // diameter of the particle
    densityParticle 1100.;                          // density of the particle
    particleGenerationSpacing 0.0010;                // spacing between particles
    numOfParticles 20000;
}

NumericalSetup
{
    dx 0.0001; // in m
    uInflow 0.01;                                   // in LBM units, should be smaller than 0.1, this then determines dt if not equal to 0
                                                    // product of number of blocks should be equal to number of used processes
    numXBlocks 4;
    numYBlocks 4;
    numZBlocks 4;

}

TemperatureSetup
{
    Thot 1;                                         // Temperature of hot wall
    Tcold 0;                                        // Temperature of cold wall
    Tref  0;                                        // Temperature of ambient
    PrandtlNumber 1;
    particleTemperature 1;
    RayleighNumber 100000;
    diffusivityRatio 0.01;
}

Output
{
    infoSpacing 0.1;                                // in s
    writeSlice  true;                               // boolean whether you want slice visualization or not. Suggested for large domain sizes
    vtkSpacingParticles 0.1;                        // in s
    vtkSpacingFluid 0.1;                            // in s
    vtkFolderName vtk_out_showcase;
}
