PhysicalSetup // all to be specified in SI/ref units
{

    xSize 0.128; // = width  // 4dp
    ySize 0.128; // = depth  // 4dp
    zSize 0.256; // = height  // 20dp

    periodicInX false;
    periodicInY false;
    periodicInZ false;

    runtime 500;
    densityFluid 1.;
    particleDiameter 0.016;
    densityParticle 1.5.;
    particleRe 40;
    dynamicFrictionCoefficient 0.4;  // wachs, 0.15 originally
    coefficientOfRestitution 0.7;    // wachs  , 0.6 originally
    collisionTimeFactor 1.0;
    particleGenerationSpacing 0.016;

}

NumericalSetup
{
    dx 0.001; // in m
    dt 0.001;  // this is the dt_SI if at all uInflow is set to 0.
    Uc 0.01;   // Ma = Uc/Cs = 0.0173 << 1    => incompressible
    // product of number of blocks should be equal to number of used processes
    numXBlocks 2;
    numYBlocks 1;
    numZBlocks 2;

    use2DRefVel false;
    useLubricationForces true;
    numberOfParticleSubCycles 10;
    useParticles true;
    useIntegrators true;
    particleSubBlockSize <8, 8, 8>;
    linkedCellWidthRation 1.01;
    particleBarriers true;
    generationDomainFraction <0.95,0.95,0.95>;
    SingleparticleLocation <0.064,0.064,0.128>;
}

TemperatureSetup
{
    Thot 1;   // ThotSI = ThotLB   (concentration conversion from SI to LB)
    Tcold 0;
    Tref  0;
    Tparticle 0;
    PrandtlNumber 0.7;
    Cpf 1;
    Cps 1;
    Kr  15;
    Gr 1000;
    Qso 0;
}

Output
{
    infoSpacing 0.001; // in s
    vtkSpacingParticles 0.001; // in s
    vtkSpacingFluid 0.001; // in s
    vtkFolder vtk_out;
    performanceLogFrequency 5000000000;
}
