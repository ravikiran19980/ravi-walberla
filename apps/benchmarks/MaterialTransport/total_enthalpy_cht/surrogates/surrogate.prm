PhysicalSetup // all to be specified in SI/ref units
{

    xSize 0.1; // = width  // 4dp
    ySize 0.05; // = depth  // 4dp
    zSize 0.05; // = height  // 20dp

    periodicInX false;
    periodicInY false;
    periodicInZ false;

    runtime 3000;
    densityFluid 1.;
    particleDiameter 0.01;
    densityParticle 1.00232.;
    particleRe 10.5;
    dynamicFrictionCoefficient 0.4;  // wachs, 0.15 originally
    coefficientOfRestitution 0.7;    // wachs  , 0.6 originally
    collisionTimeFactor 1.0;

}

NumericalSetup
{
    dx 0.001; // in m
    dt 0.001;  // this is the dt_SI if at all uInflow is set to 0.
    Ma 0.1;   // mach number
    // product of number of blocks should be equal to number of used processes
    numXBlocks 1;
    numYBlocks 2;
    numZBlocks 2;

    useLubricationForces true;
    numberOfParticleSubCycles 10;
    useParticles true;
    useIntegrators false;
    particleSubBlockSize <5, 5, 5>;
    linkedCellWidthRation 1.01;
    particleBarriers true;
    writeSlice false;
    sendDirectlyFromGPU true;
    resThreshold 1e-5;
    volfraction 0.1;
    randomParticles true;
    useCommunicationHiding false;
    base_seed 14456;
}

TemperatureSetup
{
    Thot 1;   // ThotSI = ThotLB   (concentration conversion from SI to LB)
    Tcold 0;
    Tref  0;
    Tparticle 0;
    PrandtlNumber 0.7;
    Cpf 1;
    Cps 1;
    Kr  100;
    RayleighNumber 1000000;
}

Output
{
    infoSpacing 1; // in s
    vtkSpacingParticles 1; // in s
    vtkSpacingFluid 1; // in s
    vtkFolder vtk_out_surrogates_1e8;
    performanceLogFrequency 5000000000;
}