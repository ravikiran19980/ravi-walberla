PhysicalSetup // all to be specified in SI/ref units
{

    xSize 0.08; // = width  // 4dp
    ySize 0.08; // = depth  // 4dp
    zSize 0.8; // = height  // 40dp

    periodicInX false;
    periodicInY false;
    periodicInZ false;

    runtime 500;
    densityFluid 1.;
    particleDiameter 0.02;
    densityParticle 1.00232.;
    particleRe 10.5;
    dynamicFrictionCoefficient 0.4;  // wachs, 0.15 originally
    coefficientOfRestitution 0.7;    // wachs  , 0.6 originally
    collisionTimeFactor 1.0;

}

NumericalSetup
{
    dx 0.001; // in m
    dt 0.001;  // this is the dt_SI if at all uInflow is set to 0.
    Uc 0.052;   // Ma = Uc/Cs = 0.0173 << 1    => incompressible
    numXBlocks 1;
    numYBlocks 1;
    numZBlocks 1;

    useLubricationForces true;
    numberOfParticleSubCycles 10;
    useParticles true;
    useIntegrators true;
    particleSubBlockSize <5, 5, 5>;
    linkedCellWidthRation 1.01;
    particleBarriers true;
    SingleparticleLocation <0.04,0.04,0.75>;
    writeSlice false;
    sendDirectlyFromGPU false;
}

TemperatureSetup
{
    Thot 1;   // ThotSI = ThotLB   (concentration conversion from SI to LB)
    Tcold 0;
    Tref  1;
    Tparticle 0;
    PrandtlNumber 0.7;
    Cpf 1;
    Cps 8;
    Kr  1;
    Gr 1000;
    Qso 0;
}

Output
{
    infoSpacing 0.1; // in s
    vtkSpacingParticles 0.1; // in s
    vtkSpacingFluid 0.1; // in s
    vtkFolder vtk_out_k10_big;
    performanceLogFrequency 5000000000;
    filename  velocity_vs_time_cp8.txt;
}